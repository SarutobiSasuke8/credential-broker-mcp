{
  "name": "@sarutobi-sasuke/credential-broker-mcp",
  "version": "0.1.0",
  "description": "Local-first MCP credential broker: agents use gated APIs through scoped, audited requests without ever seeing the secret.",
  "license": "Apache-2.0",
  "author": "Alexei Udall",
  "homepage": "https://github.com/SarutobiSasuke8/credential-broker-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SarutobiSasuke8/credential-broker-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SarutobiSasuke8/credential-broker-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "credentials",
    "api-gateway",
    "delegated-access"
  ],
  "bin": {
    "credential-broker-stdio": "dist/src/stdio.js",
    "credential-broker-keys": "dist/src/keys-ui.js"
  },
  "exports": {
    ".": "./dist/src/server.js",
    "./policy": "./dist/src/policy.js",
    "./engine": "./dist/src/engine.js",
    "./stdio": "./dist/src/stdio.js"
  },
  "files": [
    "dist/src",
    "config/broker.example.yaml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/stdio.js",
    "keys": "node --env-file-if-exists=.env dist/src/keys-ui.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "migrate": "node dist/src/migrate.js",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepublishOnly": "npm run check && npm audit --omit=dev --audit-level=low && npm run verify:pack",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.19.15",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
